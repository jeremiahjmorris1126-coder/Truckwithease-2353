{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.truckwithease.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "https://truckwi-bhnknc6-preview-4200.runable.site/",
      "applicationId": "truckwi-bhnknc6"
    },
    "ios": {
      "bundleIdentifier": "com.truckwithease.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "TruckWithEase uses your location to show your position on the live map and find nearby diesel."
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "name": "TruckWithEase",
    "slug": "truckwithease",
    "version": "1.0.0",
    "scheme": "truckwithease",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "TruckWithEase uses your location to show your position on the live map, find nearby diesel, and share your position with dispatch."
        }
      ]
    ],
    "owner": "jeremiahjmorris1126-coder",
    "description": "TruckWithEase: live map, fuel, and dispatch tools for truckers.",
    "privacy": "public",
    "platforms": [
      "ios",
      "android"
    ],
    "privacyPolicyUrl": "https://truckwithease-2353-desktop.vercel.app/privacy",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
