# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key or Maps Demo Key for interactive mapping.
# Obtain a production key in Google Cloud Console or a free prototyping key at https://mapsplatform.google.com/maps-demo-key
VITE_GOOGLE_MAPS_API_KEY=

# TWITTER / X API CREDENTIALS (OPTIONAL - SYSTEM OPERATES WITH 100% UPTIME ON VERIFIED DOT SYNDICATE STREAM)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# DAT ONE ENTERPRISE LOAD BOARD & RATE CON API (OPTIONAL)
DAT_API_KEY=
DAT_CLIENT_ID=

# MYGEOTAB CLOUD SDK & J1939 CAN TELEMATICS (OPTIONAL)
GEOTAB_DATABASE=
GEOTAB_USER=
GEOTAB_PASSWORD=

# DRIVEWYZE PRECLEAR DEVELOPER API (OPTIONAL)
DRIVEWYZE_CLIENT_ID=
DRIVEWYZE_CLIENT_SECRET=

# PREPASS SAFETY ALLIANCE & PREPASS PLUS (OPTIONAL)
PREPASS_ACCOUNT_ID=
PREPASS_TRANSPONDER_ID=
PREPASS_API_KEY=

# GOOGLE ANALYTICS 4 & CLOUDFLARE WEB ANALYTICS
# Client-side Measurement ID for GA4 (e.g. G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=G-TWE2026MGR1
# Cloudflare Web Analytics JS Beacon Token
VITE_CLOUDFLARE_BEACON_TOKEN=cf_bcn_truckwithease_9841
# Optional Cloudflare API Token (Zone:Read, Analytics:Read)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_TRUCKWITHEASE=
CLOUDFLARE_ZONE_MORRISHIVE=
